# WebAudit by PDFKaj — build-time configuration
# Copy this file to `.env` (or `.env.local`) and fill in the values you need.
# Every variable must keep the VITE_ prefix to be exposed to the client bundle.
# NOTE: these are PUBLIC values baked into the JS — never put secrets here.

# Canonical origin (no trailing slash). Used for canonical/OG URLs,
# robots.txt and the generated sitemap.xml. Set this to your real domain.
VITE_SITE_URL=https://webauditpro.example.com

# Google AdSense publisher id, e.g. ca-pub-1234567890123456.
# Until set, ad slots render a neutral labelled placeholder.
VITE_ADSENSE_CLIENT_ID=

# Google Analytics 4 measurement id, e.g. G-ABC123XYZ.
# Analytics only loads after the visitor consents via the cookie banner.
VITE_GA_MEASUREMENT_ID=

# Google Search Console site verification token (the content value of the
# google-site-verification meta tag). Optional.
VITE_GOOGLE_SITE_VERIFICATION=
